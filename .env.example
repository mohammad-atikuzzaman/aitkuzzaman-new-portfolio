# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Authentication (⚠️ REQUIRED — app will not start without this)
JWT_SECRET=super_secret_jwt_portfolio_key_change_in_production_2025

# CORS — Allowed frontend origin (set to your Vercel domain in production)
CORS_ORIGIN=https://your-portfolio.vercel.app

# Production mode (set to 'production' on Vercel to hide internal errors)
NODE_ENV=production

# Nodemailer / Email notifications
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
NOTIFICATION_EMAIL=your_email@gmail.com

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server Port (Local development)
PORT=5000
